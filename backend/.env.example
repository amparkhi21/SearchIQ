# ---- Application ----
NODE_ENV=development
PORT=5000

# ---- MongoDB ----
MONGO_URI=mongodb://localhost:27017/searchiq

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- OpenSearch (security plugin is disabled in docker-compose for local dev) ----
OPENSEARCH_NODE=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# ---- AI service ----
AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_KEY=dev-only-ai-key-change-me-0123456789abcdef
AI_QUERY_TIMEOUT_MS=3000
AI_EMBED_TIMEOUT_MS=30000
AI_RETRIES=2
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_RESET_MS=30000

# ---- CORS (comma-separated list of allowed frontend origins) ----
CORS_ORIGINS=http://localhost:5173

# ---- Proxy: 'false', 'true', or the number of proxy hops (e.g. 1 behind a load balancer) ----
TRUST_PROXY=false

# ---- Rate limiting (per IP) ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Stricter limit for login/register (failed attempts per window)
AUTH_RATE_LIMIT_MAX=10

# ---- Logging: error | warn | info | http | verbose | debug | silly ----
LOG_LEVEL=debug
LOG_TO_FILE=true

# ---- Startup: wait for backing services (15 x 4s = 60s) ----
STARTUP_RETRIES=15
STARTUP_RETRY_DELAY_MS=4000

# ---- Health check: max time allowed per service check ----
HEALTH_CHECK_TIMEOUT_MS=3000

# ---- Search / OpenSearch indexing ----
SEARCH_INDEX_NAME=searchiq-products-v1
SEARCH_EMBEDDING_DIMENSIONS=384
SEARCH_EMBEDDING_VERSION=minilm-v1
SEARCH_TEXT_VERSION=product-v1
SEARCH_EMBED_BATCH_SIZE=64
SEARCH_BULK_BATCH_SIZE=100
SEARCH_VECTOR_K=100
SEARCH_HYBRID_CANDIDATE_K=100
SEARCH_HYBRID_BM25_WEIGHT=0.55
SEARCH_HYBRID_VECTOR_WEIGHT=0.45
SEARCH_HYBRID_RRF_K=60
SEARCH_CACHE_TTL_SECONDS=60

# ---- Authentication ----
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production. In development a built-in dev-only secret is used when empty.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
BCRYPT_SALT_ROUNDS=12

# Refresh-token cookie. COOKIE_SECURE defaults to true only in production.
# Use COOKIE_SAME_SITE=none (with COOKIE_SECURE=true) only if frontend and API are on different domains.
COOKIE_SECURE=
COOKIE_SAME_SITE=lax

# ---- First admin account (used only by: npm run seed:admin) ----
ADMIN_NAME=SearchIQ Admin
ADMIN_EMAIL=admin@searchiq.com
ADMIN_PASSWORD=Admin@12345

SEARCH_SUGGESTION_CACHE_TTL_SECONDS=30
